# PostgreSQL connection string used by apps/api migrations, seed, and app runtimes.
# Validated by apps/api env schema; required, no default.
# The postgres service in docker-compose.yml is exposed on POSTGRES_PORT (default 5432);
# keep the port in DATABASE_URL in sync with POSTGRES_PORT.
DATABASE_URL=postgresql://together:together@localhost:5432/together

# Separate database for test suites; a worktree points this at together_wt<issue>_test in .env.test.
# Defined in .env.test and read by test runners and migration scripts.
TEST_DATABASE_URL=postgresql://together:together@localhost:5432/together_test

# Port that docker-compose maps for the postgres container (must match DATABASE_URL).
# Compose-only; not validated by the API env schema.
POSTGRES_PORT=5432

# Redis connection string used for cache/queue/pub-sub by the API.
# Compose-only; not validated by the API env schema.
REDIS_URL=redis://localhost:6379/0

# Port that docker-compose maps for the redis container (default 6379).
# Compose-only; not validated by the API env schema.
REDIS_PORT=6379

# App ports (D5): apps/api, apps/web, apps/admin bound here; defaults are 4000/5000/5100.
# The API's loadEnv() and Vite load these from the local worktree .env.
PORT=4000
WEB_PORT=5000
ADMIN_PORT=5100

# Node environment. "development" (default), "test", or "production".
# apps/api compares against "test" to keep the boot banner quiet.
NODE_ENV=development

# OTP provider. "mock" (default, dev/test) or "termii" (prod). D13/D17.
OTP_PROVIDER=mock

# Termii REST API key. Default ''; only consumed when OTP_PROVIDER=termii.
TERMII_API_KEY=

# Termii sender ID used for OTP SMS (Termii account setting). Default ''.
TERMII_SENDER_ID=

# Storage provider. "mock" (default, dev/test) or "s3" (prod). D17/D20.
STORAGE_PROVIDER=mock

# S3-compatible object storage configuration (Bun.s3). Only consumed when STORAGE_PROVIDER=s3.
STORAGE_BUCKET=together-uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=

# JWT signing secret for access tokens (apps/api src/auth, D14).
# Required, no default. Generate a new one per environment:
# `openssl rand -hex 32`.
JWT_SECRET=
