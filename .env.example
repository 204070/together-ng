# PostgreSQL connection string used by packages/db migrations, seed, and app runtimes.
# Validated by @together/config; required, no default.
# The postgres service in docker-compose.yml is exposed on POSTGRES_PORT (default 5432);
# keep the port in DATABASE_URL in sync with POSTGRES_PORT.
DATABASE_URL=postgresql://together:together@localhost:5432/together

# Separate database for test suites; a worktree points this at together_wt<issue>_test.
# Not a @together/config schema key — pinned by pin-env.ts and read only by tests.
TEST_DATABASE_URL=postgresql://together:together@localhost:5432/together_test

# Port that docker-compose maps for the postgres container (must match DATABASE_URL).
# Compose-only; not a @together/config schema key.
POSTGRES_PORT=5432

# Redis connection string used for cache/queue/pub-sub by the API.
# Compose-only; not a @together/config schema key.
REDIS_URL=redis://localhost:6379/0

# Port that docker-compose maps for the redis container (default 6379).
# Compose-only; not a @together/config schema key.
REDIS_PORT=6379

# App ports (D5): apps/api, apps/web, apps/admin bound here; defaults are 4000/5000/5100.
# pin-env.ts force-applies them over any ambient values.
PORT=4000
WEB_PORT=5000
ADMIN_PORT=5100

# Node environment. "development" (default), "test", or "production".
# apps/api compares against "test" to keep the boot banner quiet.
NODE_ENV=development

# OTP provider. "mock" (default, dev/test) or "termii" (prod). D13/D10.
OTP_PROVIDER=mock

# Termii REST API key. Default ''; only consumed when OTP_PROVIDER=termii.
TERMII_API_KEY=

# Termii sender ID used for OTP SMS (Termii account setting). Default ''.
TERMII_SENDER_ID=

# JWT signing secret for access tokens (apps/api src/auth, D14).
# Required, no default. Generate a new one per environment:
# `openssl rand -hex 32`.
JWT_SECRET=