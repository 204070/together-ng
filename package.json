{
	"name": "together-ng",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter './apps/*' build",
		"dev": "bun run --filter './apps/*' dev",
		"test": "bun run scripts/test.ts",
		"lint": "biome check .",
		"typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
		"format": "biome format --write .",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "^1.4.2",
		"typescript": "~5.9.0"
	},
	"dependencies": {
		"@together/config": "workspace:*"
	}
}
