{
	"name": "@together/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts"
	},
	"scripts": {
		"db:generate": "bun run ../../scripts/pin-env.ts drizzle-kit generate && bun ./scripts/ensure-extensions.ts",
		"db:migrate": "bun run ../../scripts/pin-env.ts bun ./src/migrate.ts",
		"db:seed": "bun run ../../scripts/pin-env.ts bun ./src/seed.ts",
		"test": "bun run ../../scripts/pin-env.ts bun test",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@together/config": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.16.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.2",
		"@types/pg": "^8.15.4",
		"drizzle-kit": "^0.31.10"
	}
}
